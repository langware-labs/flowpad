        {"id": "hubapi", "label": "Hub API", "sublabel": "auth · share", "role": "service"},
        {"id": "hubdb", "label": "Hub DB", "sublabel": "Postgres", "role": "db"},
        {"id": "llm", "label": "LLM gateway", "sublabel": "OpenRouter · Claude", "role": "service", "step": 6},
