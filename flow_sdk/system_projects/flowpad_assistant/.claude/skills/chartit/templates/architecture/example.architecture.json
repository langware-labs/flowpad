      {"id": "sandboxes", "label": "Sandboxes", "parts": [
        {"id": "e2b", "label": "E2B", "sublabel": "remote exec", "role": "external"}]}]}
  ],
  "links": [
    {"from": "electron", "to": "ui", "label": "loads"},
    {"from": "desktop", "to": "server", "label": "REST + WS", "both": true},
    {"from": "terminal", "to": "server", "label": "HTTP"},
    {"from": "server", "to": "stores", "label": "read / write", "both": true},
    {"from": "server", "to": "workers", "label": "spawns"},
    {"from": "backend", "to": "hub", "label": "login · share · LLM", "both": true},
    {"from": "hubapi", "to": "hubdb"}
  ],
  "steps": [
    {"n": 1, "text": "Electron opens the Flowpad UI in its window."},
    {"n": 2, "text": "The UI loads the bootstrap and entities over REST."},
    {"n": 3, "text": "The API server reads and writes through dataManager."},
    {"n": 4, "text": "SQLite holds every entity row and the file index."},
    {"n": 5, "text": "A chat turn spawns an agent worker (Claude Code / Codex)."},
    {"n": 6, "text": "The worker's model calls go out through the hub's LLM gateway."},
    {"n": 7, "text": "Its output streams back to the UI over the WebSocket bus."}
  ]
}
