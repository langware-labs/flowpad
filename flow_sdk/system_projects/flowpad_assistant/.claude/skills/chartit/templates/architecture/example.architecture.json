      {"id": "terminal", "label": "Terminal", "parts": [
        {"id": "cli", "label": "flow CLI", "sublabel": "per instance", "role": "client"},
        {"id": "agentshell", "label": "Agent shell", "sublabel": "Claude Code · Codex", "role": "client"}]}]},
    {"id": "backend", "label": "Local backend", "sublabel": "one per instance · ~/.flow/instances/<name>", "tiers": [
      {"id": "server", "label": "Server", "parts": [
        {"id": "api", "label": "API server", "sublabel": "FastAPI · REST", "role": "service", "step": 3},
        {"id": "ws", "label": "Event bus", "sublabel": "WebSocket", "role": "service", "step": 7},
