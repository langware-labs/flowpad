      {"id": "stores", "label": "Stores", "parts": [
        {"id": "sqlite", "label": "SQLite DB", "sublabel": "entities · index", "role": "db", "step": 4},
        {"id": "fs", "label": "Workspace", "sublabel": "agentic-assets/", "role": "files"},
        {"id": "keyring", "label": "Keyring", "sublabel": "hub token", "role": "db"}]},
      {"id": "workers", "label": "Workers", "parts": [
        {"id": "agents", "label": "Agent workers", "sublabel": "agentic processes", "role": "worker", "step": 5},
        {"id": "pty", "label": "PTY shells", "sublabel": "terminals", "role": "worker"},
        {"id": "sync", "label": "Sync engine", "sublabel": "data sources", "role": "worker"}]}]},
    {"id": "hub", "label": "Flowpad hub", "sublabel": "cloud", "tiers": [
