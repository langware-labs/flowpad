{
  "type": "data_schema",
  "fields": {
    "id": {
      "shape": "string",
      "description": "Unique id (r1, r2…): what feedback targets."
    },
    "from": {
      "shape": "string",
      "description": "The source element id."
    },
    "to": {
      "shape": "string",
      "description": "The target element id."
    },
    "label": {
      "shape": "string",
      "description": "What happens, as a short verb phrase (Reads orders, Publishes OrderPlaced)."
    },
    "tech": {
      "shape": "?string",
      "description": "How (HTTPS/JSON, gRPC, SQL, Kafka)."
    },
    "order": {
      "shape": "?int",
      "description": "The step number on a dynamic chart; defaults to list order."
    },
    "style": {
      "shape": "?enum:sync|async",
      "description": "sync: solid (default); async: dashed (events, queues)."
    },
    "note": {
      "shape": "?string",
      "description": "Shown on hover."
    }
  }
}
