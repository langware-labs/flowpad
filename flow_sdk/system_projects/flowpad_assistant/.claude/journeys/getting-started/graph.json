{
  "version": 1,
  "id": "5eaa7e57-1111-4222-8333-444455556666",
  "name": "Getting started",
  "description": "Build your first vibe agent: a shopping master that finds the best deals \u2014 created, instructed, and put to work, step by step.",
  "enabled": true,
  "auto_launch": true,
  "config": {
    "deadline_s": 2592000,
    "retention_runs": 3
  },
  "nodes": [
    {
      "id": "step0",
      "node_type": "guided_step",
      "name": "Open your project page",
      "node_data": {
        "status_line": "Click your highlighted project name in the footer to open its page.",
        "present": {
          "highlight": "ProjectPage"
        },
        "await": {
          "topic": "app.ui.button.clicked",
          "target": "ProjectPage"
        }
      }
    },
    {
      "id": "step2",
      "node_type": "guided_step",
      "name": "Create a sub agent",
      "node_data": {
        "group": "Create your vibe agent",
        "status_line": "Click the highlighted Sub agent tile and name it \"shopping-master\".",
        "present": {
          "highlight": "Sub agents"
        },
        "await": {
          "topic": "app.ui.button.clicked",
          "target": "Sub agents"
        }
      }
    },
    {
      "id": "step3",
      "node_type": "guided_step",
      "name": "Write the instructions",
      "node_data": {
        "group": "Create your vibe agent",
        "status_line": "Click \"Fill text\" to write the instructions, then Next.",
        "present": {
          "highlight": "AgentInstructions"
        },
        "await": {
          "topic": "app.journey.act.done",
          "target": "fill:AgentInstructions",
          "manual": true
        },
        "act": {
          "kind": "fill",
          "target": "AgentInstructions",
          "text": "You are shopping master, find the best deal, always show product name and price"
        }
      }
    },
    {
      "id": "step3b",
      "node_type": "guided_step",
      "name": "Use the agent",
      "node_data": {
        "status_line": "Now click the highlighted Use agent button.",
        "present": {
          "highlight": "UseAgent"
        },
        "await": {
          "topic": "app.ui.button.clicked",
          "target": "UseAgent"
        }
      }
    },
    {
      "id": "step4",
      "node_type": "guided_step",
      "name": "Use your agent",
      "node_data": {
        "group": "Use your vibe agent",
        "status_line": "Your agent is loading into a live vibe process\u2026",
        "present": {},
        "await": {
          "topic": "app.entity.created",
          "target": "agentic_process:*",
          "matchEvent": {
            "process_type": "chat"
          }
        }
      }
    },
    {
      "id": "step5",
      "node_type": "guided_step",
      "name": "Ask it to find a smartphone",
      "node_data": {
        "group": "Use your vibe agent",
        "status_line": "Ask your shopping master to search for a smartphone.",
        "present": {},
        "await": {
          "topic": "app.entity.updated",
          "target": "agentic_process:*",
          "matchEvent": {
            "status": "running"
          }
        }
      }
    },
    {
      "id": "congrats",
      "node_type": "guided_step",
      "name": "You're all set",
      "node_data": {
        "status_line": "That's it \u2014 you're ready to go! \ud83c\udf89",
        "present": {
          "dock": {
            "kind": "asset_editor",
            "vfs": "congrats.html"
          }
        },
        "await": {
          "topic": "app.page.signal",
          "target": "finish"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": {
        "node": "step0",
        "event": "done"
      },
      "to": {
        "node": "step2"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "step2",
        "event": "done"
      },
      "to": {
        "node": "step3"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "step3",
        "event": "done"
      },
      "to": {
        "node": "step3b"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "step4",
        "event": "done"
      },
      "to": {
        "node": "step5"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "step5",
        "event": "done"
      },
      "to": {
        "node": "congrats"
      }
    },
    {
      "id": "e3b",
      "from": {
        "node": "step3b",
        "event": "done"
      },
      "to": {
        "node": "step4"
      }
    }
  ],
  "start": {
    "kind": "root"
  }
}
