{
  "type": "compute_op",
  "name": "whatsapp-ask-access-token",
  "label": "Access token",
  "description": "Access token, for the number step.",
  "subkind": "ask",
  "output_spec_kind": "string",
  "exe_data": {
    "prompt": "The access token from API Setup",
    "secret": true,
    "timeout_seconds": 1800
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" number --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" number --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE number --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30
  }
}
