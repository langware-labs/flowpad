{
  "type": "compute_op",
  "name": "whatsapp-prod-subscribe",
  "label": "Meta webhook",
  "description": "Meta sends the real number's messages here. (Runs every time: the test mode already satisfies the checks it would share.)",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" subscribe",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" subscribe",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE subscribe; exit $LASTEXITCODE"
    },
    "timeout_seconds": 300
  }
}
