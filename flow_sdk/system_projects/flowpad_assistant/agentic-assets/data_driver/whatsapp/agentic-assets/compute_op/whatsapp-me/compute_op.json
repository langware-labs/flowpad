{
  "type": "compute_op",
  "name": "whatsapp-me",
  "label": "Your phone",
  "description": "A hello from the test number reaches your phone; only you may drive the agent.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" me",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" me",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE me; exit $LASTEXITCODE"
    },
    "timeout_seconds": 300
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" me --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" me --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE me --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30
  }
}
