{
  "type": "compute_op",
  "id": "d27b754c-438a-406a-b395-97f1724069d6",
  "name": "whatsapp-ask-app-secret",
  "label": "App secret",
  "description": "App secret, for the app step.",
  "subkind": "ask",
  "output_spec_kind": "string",
  "exe_data": {
    "prompt": "Your Meta app's App secret",
    "secret": true,
    "timeout_seconds": 1800
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" app --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" app --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE app --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30,
    "source_step": "app"
  }
}
