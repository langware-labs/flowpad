{
  "type": "compute_op",
  "id": "2c9fcaaa-d889-4739-bd36-f56739842b9c",
  "name": "whatsapp-prod-verify",
  "label": "Ready to send",
  "description": "The channel is verified on the real number. (Runs every time: the test mode already satisfies the checks it would share.)",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" verify",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" verify",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE verify; exit $LASTEXITCODE"
    },
    "timeout_seconds": 300
  }
}
