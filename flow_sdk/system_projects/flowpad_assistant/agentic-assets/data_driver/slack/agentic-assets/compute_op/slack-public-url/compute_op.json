{
  "type": "compute_op",
  "id": "1247a68b-0cbb-40be-aac6-365de844c194",
  "name": "slack-public-url",
  "label": "Public URL",
  "description": "Flowpad cloud holds a public URL for this computer: the address your Slack app will send events to.",
  "subkind": "cli",
  "output_spec_kind": "source.setup_shown",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" public-webhook --value",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" public-webhook --value",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE public-webhook --value; exit $LASTEXITCODE"
    },
    "timeout_seconds": 300,
    "source_step": "public-webhook"
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" public-webhook --check --value",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" public-webhook --check --value",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE public-webhook --check --value; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30,
    "source_step": "public-webhook"
  }
}
