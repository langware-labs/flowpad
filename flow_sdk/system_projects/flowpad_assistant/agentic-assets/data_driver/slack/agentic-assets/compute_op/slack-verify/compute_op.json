{
  "type": "compute_op",
  "id": "078f8fc3-0fcb-4c47-82c8-6328560c734c",
  "name": "slack-verify",
  "label": "Ready",
  "description": "Everything you are in is readable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" verify",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" verify",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE verify; exit $LASTEXITCODE"
    },
    "timeout_seconds": 300,
    "source_step": "verify"
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" verify --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" verify --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE verify --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30,
    "source_step": "verify"
  }
}
