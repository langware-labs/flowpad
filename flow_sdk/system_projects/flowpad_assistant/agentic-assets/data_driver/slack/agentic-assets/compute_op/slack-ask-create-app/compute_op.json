  "name": "slack-ask-create-app",
  "label": "Set up on Slack",
  "description": "Create your Slack app and install it: two clicks in Slack.",
  "subkind": "ask",
  "output_spec_kind": "confirm",
  "exe_data": {
    "prompt": "Set up on Slack",
    "detail": "**[Create your Slack app]({{manifest.link}})** — in Slack: **Select a workspace** (yours) → **Next** → **Create and Install** → **Allow**. Come back here and press **Continue**.",
    "submit_label": "Continue",
    "cancel_label": "Not now",
    "timeout_seconds": 1800,
    "stage": {
      "label": "Set up on Slack",
      "index": 1,
      "total": 2
    }
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" app --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" app --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE app --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30,
    "source_step": "app"
  }
