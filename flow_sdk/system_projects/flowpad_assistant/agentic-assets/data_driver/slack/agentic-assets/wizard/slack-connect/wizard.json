{
  "name": "slack-connect",
  "description": "Connect your Slack: everything you are in — DMs, group DMs, channels — in your Flowpad inbox, live, through your own Slack app.",
  "version": 1,
  "enabled": true,
  "icon": "Slack",
  "steps": [
    {
      "id": "public-url",
      "label": "Public URL",
      "kind": "compute",
      "ref": "slack-public-url",
      "bind": "url"
    },
    {
      "id": "manifest",
      "label": "Your app's blueprint",
      "kind": "compute",
      "ref": "slack-manifest",
      "bind": "manifest"
    },
    {
      "id": "ask-create-app",
      "label": "Set up on Slack",
      "kind": "compute",
      "ref": "slack-ask-create-app"
    },
    {
      "id": "ask-user-token",
      "label": "Paste the token",
      "kind": "compute",
      "ref": "slack-ask-user-token",
      "bind": "user_token"
    },
    {
      "id": "app",
      "label": "Your Slack app",
      "kind": "compute",
      "ref": "slack-app"
    },
    {
      "id": "prove",
      "label": "Live delivery",
      "kind": "compute",
      "ref": "slack-prove"
    },
    {
      "id": "verify",
      "label": "Ready",
      "kind": "compute",
      "ref": "slack-verify"
    }
  ]
}
