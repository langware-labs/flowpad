{
  "type": "compute_op",
  "id": "7ba4bf28-9c82-499d-9c1c-978c2bc713d4",
  "name": "gdrive-mount-folder",
  "label": "Make the folder",
  "description": "The source's folder in My Drive, made when missing.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" folder --value",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" folder --value",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE folder --value; exit $LASTEXITCODE"
    },
    "timeout_seconds": 60,
    "source_step": "folder"
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" folder --check --value",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" folder --check --value",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE folder --check --value; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30,
    "source_step": "folder"
  }
}
