{
  "type": "compute_op",
  "id": "4201f348-27f8-45b7-8cff-08dfef61baca",
  "name": "flow-whatsapp-answered",
  "label": "Flow running",
  "description": "Flow answers on this computer.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" answered",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" answered",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE answered; exit $LASTEXITCODE"
    },
    "timeout_seconds": 300
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" answered --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" answered --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE answered --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30
  }
}
