{
  "type": "compute_op",
  "id": "172ca80f-da4d-4a9d-b82a-53b2e5f0a773",
  "name": "flow-whatsapp-agent",
  "label": "Flow answers here",
  "description": "Flow, on this computer, answers this conversation.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" flow-agent",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" flow-agent",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE flow-agent; exit $LASTEXITCODE"
    },
    "timeout_seconds": 60
  },
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" flow-agent --check",
      "linux": "\"$FLOWPAD_FLOW\" source step \"$FLOWPAD_WIZARD_INPUT_SOURCE\" flow-agent --check",
      "win32": "& $env:FLOWPAD_FLOW source step $env:FLOWPAD_WIZARD_INPUT_SOURCE flow-agent --check; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30
  }
}
