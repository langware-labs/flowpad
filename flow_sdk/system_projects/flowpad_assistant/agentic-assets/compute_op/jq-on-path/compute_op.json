{
  "type": "compute_op",
  "id": "8673920a-a48d-4913-a470-2a7de4c30eeb",
  "name": "jq-on-path",
  "label": "jq",
  "description": "jq is on the PATH and runnable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "brew install jq-deliberately-wrong",
      "linux": "apt-get update && apt-get install -y jq-deliberately-wrong",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User') + ';' + $env:LOCALAPPDATA + '\\Microsoft\\WindowsApps'; winget install --id jqlang.jq-DELIBERATELY-WRONG -e --silent --accept-package-agreements --accept-source-agreements --disable-interactivity"
    },
    "timeout_seconds": 600
  },
  "attempts": [
    {
      "subkind": "agent",
      "exe_data": {
        "agent": "provisioner",
        "prompt": "Install jq (https://jqlang.org/download/) on this machine.",
        "retries": 1
      }
    }
  ],
  "completion_check": {
    "commands": {
      "darwin": "jq --version >/dev/null 2>&1",
      "linux": "jq --version >/dev/null 2>&1",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); jq --version *> $null; if ($LASTEXITCODE -eq 0) { exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  }
}
