{
  "type": "compute_op",
  "id": "611f60c4-037e-48a2-9fc1-3948ef773652",
  "name": "git-on-path",
  "label": "Git",
  "description": "git is on the PATH and runnable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "brew install git",
      "linux": "apt-get update && apt-get install -y git",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User') + ';' + $env:LOCALAPPDATA + '\\Microsoft\\WindowsApps'; winget install --id Git.Git -e --silent --accept-package-agreements --accept-source-agreements --disable-interactivity"
    },
    "timeout_seconds": 600
  },
  "completion_check": {
    "commands": {
      "darwin": "git --version >/dev/null 2>&1",
      "linux": "git --version >/dev/null 2>&1",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); git --version *> $null; if ($LASTEXITCODE -eq 0) { exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  }
}
