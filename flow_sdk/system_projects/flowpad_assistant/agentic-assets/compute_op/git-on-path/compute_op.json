{
  "type": "compute_op",
  "id": "611f60c4-037e-48a2-9fc1-3948ef773652",
  "name": "git-on-path",
  "label": "Git",
  "description": "git is on the PATH and runnable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "brew install git",
      "linux": "apt-get update && apt-get install -y git",
      "win32": "winget install --id Git.Git --silent"
    },
    "timeout_seconds": 600
  },
  "completion_check": {
    "commands": {
      "darwin": "git --version >/dev/null 2>&1",
      "linux": "git --version >/dev/null 2>&1",
      "win32": "git --version *> $null; if ($LASTEXITCODE -eq 0) { exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  }
}
