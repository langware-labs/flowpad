{
  "type": "compute_op",
  "id": "f2c102f7-3185-4188-89b0-1bd9a739c293",
  "name": "ask-install-ripgrep",
  "label": "Install ripgrep?",
  "description": "Asks the person whether to install ripgrep, only when it is missing.",
  "subkind": "ask",
  "exe_data": {
    "prompt": "ripgrep is required to continue",
    "detail": "It doesn't appear to be installed on your computer. Would you like to install it now?",
    "submit_label": "Install",
    "cancel_label": "Skip",
    "until_answered": true
  },
  "completion_check": {
    "commands": {
      "darwin": "rg --version >/dev/null 2>&1 && echo '{}'",
      "linux": "rg --version >/dev/null 2>&1 && echo '{}'",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); rg --version *> $null; if ($LASTEXITCODE -eq 0) { '{}'; exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  },
  "output_spec_kind": "confirm"
}
