{
  "type": "compute_op",
  "id": "b8d3911b-05eb-48b6-a6f2-4ddd22edcad7",
  "name": "python3-on-path",
  "label": "Python 3",
  "description": "python3 is on the PATH and runnable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "brew install python3",
      "linux": "apt-get update && apt-get install -y python3",
      "win32": "winget install --id Python.Python.3 --silent"
    },
    "timeout_seconds": 600
  },
  "completion_check": {
    "commands": {
      "darwin": "python3 --version >/dev/null 2>&1",
      "linux": "python3 --version >/dev/null 2>&1",
      "win32": "python3 --version *> $null; if ($LASTEXITCODE -eq 0) { exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  }
}
