{
  "type": "compute_op",
  "id": "4641ef94-ebe1-4bfb-a0ed-6e65ff8c0bda",
  "name": "ripgrep-on-path",
  "label": "ripgrep",
  "description": "ripgrep (rg) is on the PATH and runnable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "brew install ripgrep-deliberately-wrong",
      "linux": "apt-get update && apt-get install -y ripgrep-deliberately-wrong",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User') + ';' + $env:LOCALAPPDATA + '\\Microsoft\\WindowsApps'; winget install --id BurntSushi.ripgrep.MSVC-DELIBERATELY-WRONG -e --silent --accept-package-agreements --accept-source-agreements --disable-interactivity"
    },
    "timeout_seconds": 600
  },
  "attempts": [
    {
      "subkind": "agent",
      "exe_data": {
        "agent": "provisioner",
        "prompt": "Install ripgrep (https://github.com/BurntSushi/ripgrep#installation) on this machine.",
        "retries": 1
      }
    }
  ],
  "completion_check": {
    "commands": {
      "darwin": "rg --version >/dev/null 2>&1",
      "linux": "rg --version >/dev/null 2>&1",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); rg --version *> $null; if ($LASTEXITCODE -eq 0) { exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  }
}
