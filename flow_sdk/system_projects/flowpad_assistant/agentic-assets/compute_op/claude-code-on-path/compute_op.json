{
  "type": "compute_op",
  "id": "4e2bbcb8-dbdb-4182-a261-3486739b90d2",
  "name": "claude-code-on-path",
  "label": "Claude Code",
  "description": "claude (Claude Code) is runnable.",
  "subkind": "cli",
  "exe_data": {
    "commands": {
      "darwin": "curl -fsSL https://claude.ai/install.sh | bash",
      "linux": "curl -fsSL https://claude.ai/install.sh | bash",
      "win32": "irm https://claude.ai/install.ps1 | iex"
    },
    "timeout_seconds": 600
  },
  "attempts": [
    {
      "subkind": "agent",
      "exe_data": {
        "agent": "provisioner",
        "prompt": "Install Claude Code (https://docs.anthropic.com/en/docs/claude-code/getting-started) on this machine.",
        "retries": 1
      }
    }
  ],
  "completion_check": {
    "commands": {
      "darwin": "\"$FLOWPAD_FLOW\" status --refresh --check install:claude",
      "linux": "\"$FLOWPAD_FLOW\" status --refresh --check install:claude",
      "win32": "& $env:FLOWPAD_FLOW status --refresh --check install:claude; exit $LASTEXITCODE"
    },
    "timeout_seconds": 30
  }
}
