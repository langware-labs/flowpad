{
  "type": "compute_op",
  "id": "7db85027-dcea-4f50-b431-74179af1dbaa",
  "name": "ask-install-jq",
  "label": "Install jq?",
  "description": "Asks the person whether to install jq, only when it is missing.",
  "subkind": "ask",
  "exe_data": {
    "prompt": "jq is required to continue",
    "detail": "It doesn't appear to be installed on your computer. Would you like to install it now?",
    "submit_label": "Install",
    "cancel_label": "Skip",
    "until_answered": true
  },
  "completion_check": {
    "commands": {
      "darwin": "jq --version >/dev/null 2>&1 && echo '{}'",
      "linux": "jq --version >/dev/null 2>&1 && echo '{}'",
      "win32": "$env:Path += ';' + [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); jq --version *> $null; if ($LASTEXITCODE -eq 0) { '{}'; exit 0 } else { exit 1 }"
    },
    "timeout_seconds": 30
  },
  "output_spec_kind": "confirm"
}
