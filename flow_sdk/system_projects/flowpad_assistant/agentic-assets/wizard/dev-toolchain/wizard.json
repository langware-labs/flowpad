{
  "name": "Developer toolchain",
  "description": "Makes sure python3 and git are installed and runnable on this machine.",
  "version": 2,
  "enabled": true,
  "icon": "Wand2",
  "steps": [
    {
      "id": "python3",
      "label": "Python 3",
      "kind": "compute",
      "ref": "python3-on-path",
      "on_fail": "continue"
    },
    {
      "id": "git",
      "label": "Git",
      "kind": "compute",
      "ref": "git-on-path",
      "on_fail": "continue"
    }
  ]
}
