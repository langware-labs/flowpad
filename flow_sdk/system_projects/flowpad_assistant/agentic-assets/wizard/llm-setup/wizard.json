      "label": "Git",
      "kind": "wizard",
      "ref": "llm-setup-git",
      "on_fail": "continue"
    },
    {
      "id": "node",
      "label": "Node.js",
      "kind": "wizard",
      "ref": "llm-setup-node",
      "on_fail": "continue"
