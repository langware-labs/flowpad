{
  "schema": 1,
  "name": "twilio",
  "title": "Twilio",
  "icon_name": "MessageSquare",
  "description": "Twilio REST API credentials for sending SMS and voice.",
  "help_url": "https://console.twilio.com/",
  "default_store": "env-local",
  "vars": {
    "TWILIO_ACCOUNT_SID": {
      "label": "Account SID",
      "placeholder": "AC…",
      "pattern": "^AC[0-9a-fA-F]{32}$",
      "secret": false,
      "required": true,
      "account_key": true
    },
    "TWILIO_AUTH_TOKEN": {
      "label": "Auth token",
      "hint": "Console → Account Info → Auth Token.",
      "help_url": "https://console.twilio.com/",
      "secret": true,
      "required": true
    }
  }
}
