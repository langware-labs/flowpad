// Version resource for flowpad-install.exe (shipped as Flowpad-Setup.exe).
// Compiled by build.rs only for the Windows target and linked only into this binary.
#include <winver.h>

1 ICON "../../electron/resources/icons/icon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Langware INC."
      VALUE "FileDescription",  "Flowpad installer launcher"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "flowpad-install"
      VALUE "LegalCopyright",   "Copyright (c) Langware Labs"
      VALUE "OriginalFilename", "Flowpad-Setup.exe"
      VALUE "ProductName",      "Flowpad"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
