{
  "type": "compute_op",
  "name": "ripgrep-on-path",
  "label": "ripgrep",
  "description": "The rg CLI is on the PATH.",
  "completion_check": {
    "commands": {
      "linux": "command -v rg"
    }
  },
  "attempts": [
    {
      "kind": "command",
      "commands": {
        "linux": "apt-get install -y ripgrep"
      }
    },
    {
      "kind": "agent",
      "agent": "provisioner",
      "prompt": "Reach this goal on this machine."
    }
  ]
}
