{
  "type": "compute_op",
  "name": "apk-cache-warm",
  "label": "the apk cache",
  "icon": "Layers",
  "description": "Alpine's package index is warm \u2014 on Alpine only.",
  "check": {
    "commands": {
      "linux": "test -f /etc/alpine-release || exit 3"
