{
  "type": "compute_op",
  "name": "git-on-path",
  "label": "git",
  "description": "git is on the PATH.",
  "completion_check": {
    "commands": {
      "linux": "command -v git"
    }
  },
  "attempts": [
    {
      "kind": "command",
      "commands": {
        "linux": "apt-get update && apt-get install -y git"
      }
    }
  ]
}
