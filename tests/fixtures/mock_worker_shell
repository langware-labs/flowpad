#!/bin/sh
# Test-instance $SHELL for the mock worker (see mock_worker_bin/claude).
#
# Capability discovery asks "$SHELL -ilc 'printf "%s" "$PATH"'" for the PATH a
# terminal would have; a real login shell re-reads the dotfiles and drops the
# mock bin folder the test instance put first. Answer THAT probe with the PATH
# this process was given; every other invocation (a real terminal tab) is zsh.
if [ "$1" = "-ilc" ] && [ "$#" -eq 2 ]; then
  exec /bin/sh -c "$2"
fi
exec /bin/zsh "$@"
