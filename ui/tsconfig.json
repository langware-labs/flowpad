{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@src/*": ["./src/*"],
      "@sdk": ["../ts_sdk/src/index.ts"],
      "@sdk/*": ["../ts_sdk/src/*"]
    }
  },
  // A references-only root: `tsc -p .` here checks NOTHING. Type-check with
  // `npm run type-check` (app + node configs; CI adds type-check:ceiling).
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tests/tsconfig.json" }
  ]
}
