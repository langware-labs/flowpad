  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sdk": "vite build --config vite.iife.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:vitest:unit && npm run test:vitest:api && npm run test:vitest:react",
    "test:vitest": "npm run test:vitest:unit && npm run test:vitest:api && npm run test:vitest:react",
    "test:vitest:unit": "vitest run --silent=false --allowOnly --bail 1 --project unit",
    "test:vitest:api": "vitest run --silent=false --allowOnly --bail 1 --project api",
    "test:vitest:react": "vitest run --silent=false --allowOnly --bail 1 --project react",
    "test:vitest:long": "vitest run --silent=false --allowOnly --bail 1 --project long",
    "test:vitest:hub": "vitest run --silent=false --allowOnly --bail 1 --project hub",
    "test:vitest:long:claude": "FLOWPAD_DEFAULT_WORKER=claude vitest run --silent=false --allowOnly --bail 1 --project long",
    "test:vitest:long:codex": "FLOWPAD_DEFAULT_WORKER=codex vitest run --silent=false --allowOnly --bail 1 --project long",
    "test:vitest:long_all": "npm run test:vitest:unit && npm run test:vitest:api && npm run test:vitest:long",
    "test:vitest:only": "vitest only --silent=false --run --allowOnly --bail 1",
    "test:vitest:watch": "vitest"
  },
