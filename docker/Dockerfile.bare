# The box the builtin worker exists for: FlowPad and NOTHING else.
#
# No Node, no npm, and none of the four harness CLIs — so the only worker that can possibly run
# here is the one that ships inside FlowPad's own Python environment (the hidden ``deepagents``
# vendor, funded by an LLM endpoint alone). ``Dockerfile.no-claude`` proves a wizard can install
# claude on a box that still has Node and opencode; this one proves a turn can run with neither.
#
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml README.md ./
COPY flow_sdk ./flow_sdk
RUN uv pip install --system .
# Same pin as the sibling images: an unconstrained resolve can land a fastmcp 4 pre-release
# whose mcp 2.0 beta drops ``mcp.types`` (the server crashes on import).
RUN uv pip install --system 'fastmcp<4' 'mcp<2'

# The premise, asserted at BUILD time so a later layer can never quietly break it: no harness
# CLI, no Node — and the builtin worker's harness IS present, answering from package metadata.
RUN for bin in claude codex copilot opencode node npm; do \
      if command -v "$bin" >/dev/null 2>&1; then echo "PREMISE BROKEN: $bin is on PATH"; exit 1; fi; \
    done \
 && python -m flow_sdk.builtin.agentic_process.cli_drivers.deepagents.runner --version

ENV PYTHON_KEYRING_BACKEND=keyrings.alt.file.PlaintextKeyring

EXPOSE 9000-9100

CMD ["python", "-m", "flow_sdk.server.run"]
