{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "importHelpers": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "typeRoots": ["../ui/node_modules/@types", "../ui/node_modules"],
    "types": ["vite/client", "vitest/jsdom", "node"],
    /* Bundler mode */
    "moduleResolution": "bundler",
    /* The SDK now ships one component (react/FlowIcon.tsx). React itself stays
       external — see ui/vite.sdk.config.ts — this only lets tsc read the JSX. */
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
